# Required: Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Required: MongoDB connection string for wallet users and transactions
MONGODB_URI=

# Optional: public base URL for the Mini App. Store only the base URL, not /app.
# CookMyBots/Render may also provide PUBLIC_BASE_URL or RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=http://localhost:4000
PUBLIC_BASE_URL=

# Optional: web server port. Render sets PORT automatically.
PORT=4000

# Auto-synced env keys detected from process.env usage:
PUBLIC_URL=
RENDER_EXTERNAL_URL=
WEB_APP_URL=
WEBAPP_URL=

