# Required: Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Required: MongoDB connection string for wallet users and transactions
MONGODB_URI=

# Optional: web server port. Render sets PORT automatically.
PORT=4000

# Optional: public base URL used for the Mini App button. Store only the base URL, not /app.
APP_BASE_URL=http://localhost:4000

# Optional: CookMyBots/Render managed public URL aliases. Store only the base URL, not /app.
PUBLIC_BASE_URL=
RENDER_EXTERNAL_URL=
WEBAPP_URL=
WEB_APP_URL=
PUBLIC_URL=
